return function()
	local Math = require(game.ReplicatedStorage.LIB)

	describe("constants", function()
		it("matches Luau math constants", function()
			expect(Math.PI).to.equal(math.pi)
			expect(Math.SQRT2).to.be.close(math.sqrt(2), 1e-6)
		end)
	end)

	describe("single-value wrappers", function()
		it("matches built-in math functions", function()
			expect(Math.abs(-5)).to.equal(5)
			expect(Math.acos(1)).to.equal(math.acos(1))
			expect(Math.asin(0.5)).to.equal(math.asin(0.5))
			expect(Math.atan(1)).to.equal(math.atan(1))
			expect(Math.ceil(1.2)).to.equal(2)
			expect(Math.floor(1.8)).to.equal(1)
			expect(Math.cos(1)).to.equal(math.cos(1))
			expect(Math.exp(2)).to.equal(math.exp(2))
			expect(Math.log(8)).to.equal(math.log(8))
			expect(Math.log2(8)).to.equal(3)
			expect(Math.log10(100)).to.equal(2)
			expect(Math.pow(2, 4)).to.equal(16)
			expect(Math.sin(1)).to.equal(math.sin(1))
			expect(Math.sqrt(9)).to.equal(3)
			expect(Math.tan(1)).to.equal(math.tan(1))
		end)
	end)

	describe("derived functions", function()
		it("computes hyperbolic inverse functions", function()
			local n = 2
			expect(Math.acosh(n)).to.be.close(math.log(n + math.sqrt(n ^ 2 - 1)), 1e-6)
			expect(Math.asinh(n)).to.be.close(math.log(n + math.sqrt(n ^ 2 + 1)), 1e-6)
			expect(Math.atanh(0.5)).to.be.close(0.5 * math.log(3), 1e-6)
		end)

		it("computes rounding helpers", function()
			expect(Math.cbrt(27)).to.be.close(3, 1e-6)
			expect(Math.cbrt(-27)).to.be.close(-3, 1e-6)
			expect(Math.f16round(65520)).to.equal(math.huge)
			expect(Math.f16round(2 ^ -24)).to.equal(2 ^ -24)
			expect(Math.round(1.5)).to.equal(2)
			expect(Math.sign(-42)).to.equal(-1)
			expect(Math.trunc(-1.8)).to.equal(-1)
		end)

		it("computes aggregate helpers", function()
			expect(Math.hypot(3, 4, 12)).to.equal(13)
			expect(Math.hypot(1e200, 1e200)).to.be.close(1.4142135623730951e200, 1e185)
			expect(Math.max()).to.equal(-math.huge)
			expect(Math.max(1, 9, 3)).to.equal(9)
			expect(Math.min()).to.equal(math.huge)
			expect(Math.min(1, -9, 3)).to.equal(-9)
		end)

		it("computes 32-bit helpers", function()
			expect(Math.clz32(1)).to.equal(31)
			expect(Math.imul(2, -4)).to.equal(-8)
		end)
	end)
end
